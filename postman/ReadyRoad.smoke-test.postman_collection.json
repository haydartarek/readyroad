  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request script",
          "console.log('🚀 Starting smoke test run...');",
          "console.log('Base URL:', pm.environment.get('baseUrl'));",
          "console.log('Timestamp:', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level test script runs after each request",
          "const testResults = pm.response.code === 200 || pm.response.code === 404;",
          "",
          "if (!testResults) {",
          "    console.error('❌ Unexpected status code:', pm.response.code);",
          "}"
        ]
      }
    }
  ],
  "variable": [
