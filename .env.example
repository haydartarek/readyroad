# ReadyRoad local environment template.
# Copy to .env and replace every replace_with_* value before startup.

# MySQL and application database
MYSQL_ROOT_PASSWORD=replace_with_secure_root_password
DB_NAME=readyroad_prod
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=replace_with_database_username
DB_PASSWORD=replace_with_secure_database_password

# Isolated local PostgreSQL profile (not used by the default MySQL stack)
POSTGRES_DB=readyroad_postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USERNAME=replace_with_postgresql_username
POSTGRES_PASSWORD=replace_with_secure_postgresql_password
POSTGRES_SSLMODE=disable
POSTGRES_SCHEMA=public

# Optional deployment aliases accepted by the PostgreSQL profile.
# For Supabase, use database "postgres", SSL mode "require", and either a
# direct connection or the Session Pooler on port 5432.
# POSTGRES_DATABASE=postgres
# POSTGRES_SSL_MODE=require

# Conservative HikariCP defaults suitable for a small hosted PostgreSQL plan.
POSTGRES_MAX_POOL_SIZE=5
POSTGRES_MIN_IDLE=1
POSTGRES_CONNECTION_TIMEOUT=30000
POSTGRES_IDLE_TIMEOUT=300000
POSTGRES_MAX_LIFETIME=1200000

# Default administrator. The backend synchronizes this password at startup.
ADMIN_DEFAULT_PASSWORD=replace_with_secure_admin_password

# Base64-encoded JWT key representing at least 32 random bytes.
JWT_SECRET=replace_with_long_random_base64_secret

# Browser origins and public application URL
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMTP and password-reset mail
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_app_password
MAIL_FROM=replace_with_mail_from_address

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USER_INFO_URI=https://openidconnect.googleapis.com/v1/userinfo

# Optional JVM tuning
# JAVA_OPTS=-Xms512m -Xmx1024m
