# ============================================
# ReadyRoad Environment Variables
# ============================================
# Copy this file to .env and update values
# ============================================

# MySQL Root Password (for administrative tasks)
MYSQL_ROOT_PASSWORD=change-me-local-root-password

# Application Database Password (required for Docker startup)
DB_PASSWORD=change-me-local-db-password

# Admin User Password (REQUIRED - change this!)
ADMIN_DEFAULT_PASSWORD=ChangeMeLocalAdminPassword!

# JWT Secret (RECOMMENDED to change for production)
JWT_SECRET=cmVhZHlyb2FkLWRldi1vbmx5LWp3dC1zZWNyZXQtb3ZlcnJpZGUtaW4tcmVhbC1lbnZpcm9ubWVudHMtMjAyNg==

# Public frontend URL (used in auth-related redirects and emails)
FRONTEND_URL=http://localhost:3000

# Google OAuth (required for social login)
# Local redirect URI: http://localhost:3000/api/auth/google/callback
# Production example: https://readyroad.be/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USER_INFO_URI=https://openidconnect.googleapis.com/v1/userinfo

# Optional Overrides
# DB_USERNAME=haydar
# DB_NAME=readyroad_prod
# DB_HOST=mysql
# DB_PORT=3306

# Optional Mail Overrides
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=noreply@readyroad.be

# Java Options (Optional)
# JAVA_OPTS=-Xms512m -Xmx1024m
